# Copy to .env.local and fill in.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
COACH_MODEL=gemini-3.8-flash
MEMORY_MODEL=gemini-3.8-flash

# Google Health (optional — the app runs on sample data without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Name the coach uses
USER_NAME=Alex
